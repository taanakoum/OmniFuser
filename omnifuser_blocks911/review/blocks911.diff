+def test_b10_a_tiny_model_overfits_a_tiny_batch():
+    """Sanity of the optimisation path (loss -> backward -> Adam).  Three samples are fewer than the free parameters
+    of the tiny linear model, so both the force and the class loss can be driven down; lr 1e-2 instead of the
+    paper's 1e-4 so that 400 steps are enough.  (A NumPy replica of this run ends at 2 - 8 % of the initial loss.)"""
+    need_autograd()
+    from omnifuser.models import multitask_loss
+
+    torch.manual_seed(0)
+    model, _, parts = _tiny_training_pieces(2, [3])
+    part = parts[0]
+    optimizer = torch.optim.Adam(model.parameters(), lr=1e-2)
+    losses = []
+    for _ in range(400):
+        optimizer.zero_grad()
+        out = model(part["force"], part["images"], part["image_indices"], part["cycle"], part["batch"], part["relative"])
+        loss = multitask_loss(out, part["force_target"], part["class_target"])[0]
+        loss.backward()
+        optimizer.step()
+        losses.append(float(loss))
+    assert losses[-1] < 0.15 * losses[0], (losses[0], losses[-1])
