+    per_lead = regression_report(pred, true, np.zeros(3), np.ones(3))["by_horizon_normalized"]
+    for horizon in b9.PAPER_HORIZONS:
+        assert np.isclose(cumulative[str(horizon)]["mse"], np.mean([e["mse"] for e in per_lead[:horizon]]), rtol=1e-12)
+
