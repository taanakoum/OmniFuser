+"""Blocks 9-11: recursive refinement and prediction heads (Eq. 20-23), the training objective and protocol, and the
+scores of Sec. VI-A2 / Tables IV-V, checked against the NumPy reference in tests/blocks9_11_reference.py.
+
+    python tests/test_blocks_9_11.py          # or: python -m pytest tests/test_blocks_9_11.py
+
+Which tests need what
+* test_b9_ref_*, test_b11_* and the data tests of Block 10 need only numpy / scipy / Pillow (the data and evaluation
+  modules import torch, so a torch of any kind must be importable).
+* Tests that build the real ``OmniFuser`` need PyTorch.  The front end (embeddings, MRTE/RTD, image branch) is replaced
+  by a module that returns a fixed stream, so only Eq. 20-23 are under test; the front end is Block 12.
+* Tests marked (autograd) need real autograd and are skipped on the NumPy stand-in used where PyTorch is unavailable.
+"""
+from __future__ import annotations
+
+import ast
+import itertools
+import sys
+import traceback
+import unittest
+from pathlib import Path
+
+import numpy as np
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT))
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+
+import blocks9_11_reference as b9  # noqa: E402
+import c2f_reference as ref  # noqa: E402
+import test_c2f_blocks678 as t6  # noqa: E402
+from test_alignment_patch import Workspace, make_nonastreda  # noqa: E402
