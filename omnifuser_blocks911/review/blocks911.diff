+                                 rng.standard_normal((D, 3)), rng.standard_normal(3), HORIZON)
+    assert y.shape == (HORIZON, 3) and o.shape == (HORIZON, 3)
+    assert all(np.array_equal(y[0], y[j]) and np.array_equal(o[0], o[j]) for j in range(HORIZON))
+    y, o = b9.head_direct(z_t, rng.standard_normal((D, HORIZON * 3)), rng.standard_normal(HORIZON * 3),
+                          rng.standard_normal((D, HORIZON * 3)), rng.standard_normal(HORIZON * 3), HORIZON, 3)
+    assert not np.allclose(y[0], y[1]) and not np.allclose(o[0], o[1])
+    table = rng.standard_normal((HORIZON, D))
+    y, o = b9.head_lead_conditioned(z_t, table, rng.standard_normal((2 * D, D)), rng.standard_normal(D),
+                                    rng.standard_normal((D, 3)), rng.standard_normal(3),
+                                    rng.standard_normal((D, 3)), rng.standard_normal(3))
+    assert not np.allclose(y[0], y[1])
