+# ================================================================================================ Block 9 (real model)
+class _Fixed:
+    """Stand-in for a front-end module: returns the stream stored in ``value`` whatever it is called with."""
+
+
+def _fixed_module():
+    import torch.nn as nn
+
+    class Fixed(nn.Module):
+        def __init__(self):
+            super().__init__()
+            self.value = None
+
+        def forward(self, *args, **kwargs):
+            return self.value
+
+    return Fixed()
+
+
+def build_model(**overrides):
+    """Real ``OmniFuser`` (fusion layers, refinement maps, heads) with the front end replaced by fixed streams."""
+    import omnifuser.models as M
+    from omnifuser.config import ModelConfig
+
+    settings = dict(d_model=D, input_len=T, horizon=HORIZON, force_channels=CHANNELS, num_classes=CLASSES,
+                    num_landmarks=K, fusion_rank=RANK, num_gat_heads=HEADS, dropout=0.0, image_encoder="compact")
+    settings.update(overrides)
+    saved = M.TemporalEmbedding, M.MultiResolutionTemporalExtractor, M.ImageBranch
+    M.TemporalEmbedding = M.MultiResolutionTemporalExtractor = M.ImageBranch = lambda config: _fixed_module()
+    try:
+        model = M.OmniFuser(ModelConfig(**settings))
+    finally:
+        M.TemporalEmbedding, M.MultiResolutionTemporalExtractor, M.ImageBranch = saved
+    return model.double().eval()
+
+
+def randomize_model(model, seed: int) -> None:
+    rng = np.random.default_rng(seed)
+    with torch.no_grad():
+        for name, p in model.named_parameters():
+            shape = tuple(p.shape)
+            if "gate_mix" in name:
+                value = rng.normal(0.0, 1.0, size=shape)
+            elif "norm" in name and name.endswith("weight"):
+                value = 1.0 + 0.2 * rng.standard_normal(shape)
+            elif name.endswith("bias") or "norm" in name:
+                value = 0.1 * rng.standard_normal(shape)
+            else:
+                value = rng.standard_normal(shape) / np.sqrt(shape[-1] if shape else 1)
+            p.copy_(torch.as_tensor(np.asarray(value), dtype=p.dtype))
+
+
+def run_model(model, s_r: np.ndarray, s_i: np.ndarray, **kwargs):
+    """Forward pass with the two fused-input streams fixed to s_r (sensor) and s_i (image); s_* are (B, T, d)."""
+    batch = s_r.shape[0]
+    model.temporal_encoder.value = t6.as_tensor(s_r)
+    model.image_branch.value = t6.as_tensor(s_i)
+    force = torch.zeros((batch, model.config.input_len, CHANNELS), dtype=torch.float64)
+    images = torch.zeros((batch, 1, 3, 2, 2), dtype=torch.float64)
+    indices = torch.zeros((batch, model.config.input_len), dtype=torch.long)
+    return model(force, images, indices, **kwargs)
+
+
+def reference_outputs(model, s_r: np.ndarray, s_i: np.ndarray, zero: str | None = None):
+    """Eq. 20-23 evaluated by the reference with the weights of ``model``.  Returns force (B, P, C), logits (B, P, 3)."""
+    cfg = model.config
+    layers = [t6.extract_params(layer) for layer in model.fusion_layers]
+    proj_r = [t6._a(m.weight).T for m in model.refine_sensor]
+    proj_i = [t6._a(m.weight).T for m in model.refine_image]
+    options = dict(heads=cfg.num_gat_heads, als_mode=cfg.als_mode, private_attn=cfg.private_attn, pre_attn=cfg.pre_attn)
+    forces, logits = [], []
+    for b in range(s_r.shape[0]):
+        z_r, z_i = s_r[b], s_i[b]
+        if zero == "sensor":
+            z_r = np.zeros_like(z_r)
+        elif zero == "image":
+            z_i = np.zeros_like(z_i)
+        z_t = b9.refine(z_r, z_i, layers, proj_r, proj_i, **options)[-1][-1]
+        if cfg.prediction_head == "paper_literal":
+            y, o = b9.head_paper_literal(z_t, t6._a(model.force_head.weight).T, t6._a(model.force_head.bias),
+                                         t6._a(model.classification_head.weight).T,
+                                         t6._a(model.classification_head.bias), cfg.horizon)
+        elif cfg.prediction_head == "direct":
+            y, o = b9.head_direct(z_t, t6._a(model.direct_force.weight).T, t6._a(model.direct_force.bias),
+                                  t6._a(model.direct_class.weight).T, t6._a(model.direct_class.bias),
+                                  cfg.horizon, cfg.force_channels, cfg.num_classes)
+        else:
+            y, o = b9.head_lead_conditioned(
+                z_t, t6._a(model.forecast_step_embedding.weight), t6._a(model.forecast_projection[0].weight).T,
+                t6._a(model.forecast_projection[0].bias), t6._a(model.force_head.weight).T,
+                t6._a(model.force_head.bias), t6._a(model.classification_head.weight).T,
+                t6._a(model.classification_head.bias))
+        forces.append(y)
+        logits.append(o)
+    return np.stack(forces), np.stack(logits)
+
+
+def _compare(model, seed: int, zero: str | None = None, **kwargs) -> float:
+    s_r, s_i = t6.random_streams(seed, batch=3, steps=T)
+    with torch.no_grad():
+        out = run_model(model, s_r, s_i, **kwargs)
+    force, logits = reference_outputs(model, s_r, s_i, zero)
+    assert out["force"].shape == (3, model.config.horizon, CHANNELS)
+    assert out["class_logits"].shape == (3, model.config.horizon, CLASSES)
+    dif = max(np.abs(t6._a(out["force"]) - force).max(), np.abs(t6._a(out["class_logits"]) - logits).max())
+    assert np.allclose(t6._a(out["force"]), force, rtol=1e-6, atol=1e-8), dif
+    assert np.allclose(t6._a(out["class_logits"]), logits, rtol=1e-6, atol=1e-8), dif
+    return float(dif)
+
+
+def test_b9_random_params_have_the_layout_of_extract_params():
+    need_torch()
+    layer = t6.make_layer()
+    t6.randomize(layer, 20)
+    real, fake = t6.extract_params(layer), random_params(21)
+    for m in ("r", "i", "lr"):
+        assert set(real[m]) == set(fake[m]), m
+        for key in real[m]:
+            assert np.shape(real[m][key]) == np.shape(fake[m][key]), (m, key)
+
+
+def test_b9_model_matches_reference_for_every_head_round_count_and_sharing():
+    need_torch()
+    worst = 0.0
+    for head, rounds, share in itertools.product(HEAD_KINDS, (1, 2, 3), (False, True)):
+        model = build_model(prediction_head=head, num_fusion_layers=rounds, share_c2f=share)
+        randomize_model(model, 30 + rounds)
+        worst = max(worst, _compare(model, 31, ))
+    assert worst < 1e-9, worst
+
+
+def test_b9_model_matches_reference_for_the_layer_options():
+    need_torch()
+    for mode, private, pre in itertools.product(("time", "k_sum", "k_colnorm"), ("residual_ln", "plain"), (False, True)):
+        model = build_model(prediction_head="direct", als_mode=mode, private_attn=private, pre_attn=pre)
+        randomize_model(model, 40)
+        _compare(model, 41)
+
+
+def test_b9_paper_defaults_n2_k4_r8_d32_match_reference_at_T96():
+    need_torch()
+    import omnifuser.models as M
+    from omnifuser.config import ModelConfig
+
+    cfg = ModelConfig()
+    assert (cfg.d_model, cfg.num_fusion_layers, cfg.num_landmarks, cfg.fusion_rank, cfg.num_gat_heads) == (32, 2, 4, 8, 4)
+    model = build_model(input_len=96, horizon=24, prediction_head="direct")
+    randomize_model(model, 50)
+    s_r, s_i = t6.random_streams(51, batch=2, steps=96)
+    with torch.no_grad():
+        out = run_model(model, s_r, s_i)
+    force, logits = reference_outputs(model, s_r, s_i)
+    assert np.allclose(t6._a(out["force"]), force, rtol=1e-6, atol=1e-8)
+    assert np.allclose(t6._a(out["class_logits"]), logits, rtol=1e-6, atol=1e-8)
+    assert M.OmniFuser is not None
+
+
+def test_b9_second_round_depends_on_the_first_through_refine_maps():
+    need_torch()
+    model = build_model(prediction_head="direct", num_fusion_layers=2)
+    randomize_model(model, 60)
+    s_r, s_i = t6.random_streams(61, batch=2)
+    with torch.no_grad():
+        before = t6._a(run_model(model, s_r, s_i)["force"])
+        for m in list(model.refine_sensor) + list(model.refine_image):
+            m.weight.copy_(torch.zeros_like(m.weight))
+        zeroed = t6._a(run_model(model, s_r, s_i)["force"])
+    assert not np.allclose(before, zeroed)
+    # with zero maps round two sees the original streams: it is G_2(Z^r, Z^i), the second layer applied to the input
+    force, _ = reference_outputs(model, s_r, s_i)
+    assert np.allclose(zeroed, force, rtol=1e-6, atol=1e-8)
+
+
+def test_b9_share_c2f_uses_one_layer_and_counts_parameters_once():
+    need_torch()
+    separate, shared = build_model(num_fusion_layers=2), build_model(num_fusion_layers=2, share_c2f=True)
+    count = lambda module: sum(int(np.prod(p.shape)) for p in module.parameters())      # noqa: E731
+    assert shared.fusion_layers[0] is shared.fusion_layers[1] and separate.fusion_layers[0] is not separate.fusion_layers[1]
+    layer = count(separate.fusion_layers[0])
+    assert count(separate) - count(shared) == layer
+    one_round = build_model(num_fusion_layers=1, share_c2f=True)
+    assert count(one_round.fusion_layers[0]) == layer and len(one_round.refine_sensor) == 0
