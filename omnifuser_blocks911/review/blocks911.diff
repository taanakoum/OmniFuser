+    pr, pi = rng.standard_normal((D, D)) / np.sqrt(D), rng.standard_normal((D, D)) / np.sqrt(D)
+    first, second = b9.refine(z_r, z_i, [params, params], [pr], [pi], heads=HEADS)
+    expected = ref.c2f_layer(z_r + first @ pr, z_i + first @ pi, params, heads=HEADS)["Z_hat"]
