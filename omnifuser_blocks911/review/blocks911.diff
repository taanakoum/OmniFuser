+def _tiny_training_pieces(seed: int, batches: list[int], horizon: int = 3):
+    import torch.nn as nn
+
+    class Tiny(nn.Module):
+        def __init__(self):
+            super().__init__()
+            self.force_map = nn.Linear(CHANNELS, horizon * CHANNELS)
+            self.class_map = nn.Linear(CHANNELS, horizon * CLASSES)
+
+        def forward(self, force, images, indices, cycle, batch, relative):
+            last = force[:, -1]
+            return {"force": self.force_map(last).view(-1, horizon, CHANNELS),
+                    "class_logits": self.class_map(last).view(-1, horizon, CLASSES),
+                    "alignment_loss": force.new_zeros(()), "orthogonality_loss": force.new_zeros(())}
+
+    class Loader:
+        def __init__(self, parts):
+            self.parts, self.dataset = parts, [None] * sum(len(p["force"]) for p in parts)
+
+        def __len__(self):
+            return len(self.parts)
+
+        def __iter__(self):
+            return iter(self.parts)
+
+    rng = np.random.default_rng(seed)
+    parts = []
+    for size in batches:
+        parts.append({"force": torch.as_tensor(rng.standard_normal((size, 4, CHANNELS))),
+                      "images": torch.zeros((size, 1)), "image_indices": torch.zeros((size, 4), dtype=torch.long),
+                      "cycle": torch.zeros((size, 4), dtype=torch.long), "batch": torch.zeros((size, 4), dtype=torch.long),
+                      "relative": torch.zeros((size, 4), dtype=torch.long),
+                      "force_target": torch.as_tensor(rng.standard_normal((size, horizon, CHANNELS))),
+                      "class_target": torch.as_tensor(rng.integers(0, CLASSES, (size, horizon))),
+                      "shown_label": torch.zeros(size, dtype=torch.long)})
+    model = Tiny().double()
+    return model, Loader(parts), parts
+
+
+def _merge(parts):
+    return {key: torch.cat([p[key] for p in parts]) for key in parts[0]}
+
+
+def test_b10_gradient_accumulation_equals_one_larger_batch_and_handles_a_short_last_group():
+    need_autograd()
+    from omnifuser.models import multitask_loss
+    from omnifuser.train import _run_epoch
+
+    # (a) two batches of 4 with accumulation 2 == one batch of 8
+    model_a, loader_a, parts = _tiny_training_pieces(0, [4, 4])
+    model_b, loader_b, _ = _tiny_training_pieces(0, [4, 4])
+    model_b.load_state_dict(model_a.state_dict())
+    big = _merge(parts)
+    loader_big = type(loader_a)([big])
+    opt_a, opt_b = torch.optim.SGD(model_a.parameters(), lr=0.05), torch.optim.SGD(model_b.parameters(), lr=0.05)
+    _run_epoch(model_a, loader_a, opt_a, torch.device("cpu"), None, accumulation_steps=2)
+    _run_epoch(model_b, loader_big, opt_b, torch.device("cpu"), None, accumulation_steps=1)
+    for (name, p), (_, q) in zip(model_a.named_parameters(), model_b.named_parameters()):
+        assert torch.allclose(p, q, rtol=1e-9, atol=1e-11), name
+    # (b) three batches, accumulation 2: step 1 = mean gradient of batches 1-2, step 2 = full gradient of batch 3
+    model_c, loader_c, parts3 = _tiny_training_pieces(1, [4, 4, 4])
+    model_d, _, _ = _tiny_training_pieces(1, [4, 4, 4])
+    model_d.load_state_dict(model_c.state_dict())
+    _run_epoch(model_c, loader_c, torch.optim.SGD(model_c.parameters(), lr=0.05), torch.device("cpu"), None,
+               accumulation_steps=2)
+    opt = torch.optim.SGD(model_d.parameters(), lr=0.05)
+    for group in ([parts3[0], parts3[1]], [parts3[2]]):
+        opt.zero_grad()
+        for part in group:
+            out = model_d(part["force"], part["images"], part["image_indices"], part["cycle"], part["batch"], part["relative"])
+            (multitask_loss(out, part["force_target"], part["class_target"])[0] / len(group)).backward()
+        torch.nn.utils.clip_grad_norm_(model_d.parameters(), max_norm=1.0)
+        opt.step()
+    for (name, p), (_, q) in zip(model_c.named_parameters(), model_d.named_parameters()):
+        assert torch.allclose(p, q, rtol=1e-9, atol=1e-11), name
