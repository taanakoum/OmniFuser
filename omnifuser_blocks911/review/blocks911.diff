+# ================================================================================================ numpy-only helpers
+def random_params(seed: int, d: int = D, k: int = K, rank: int = RANK) -> dict:
+    """Random weights of one C2F layer in the layout of ``test_c2f_blocks678.extract_params`` (numpy only)."""
+    rng = np.random.default_rng(seed)
+
+    def w(*shape):
+        return rng.standard_normal(shape) / np.sqrt(shape[-1] if len(shape) > 1 else d)
+
+    params: dict = {}
+    for m in ("r", "i"):
+        params[m] = {
+            "shared": w(d, d), "score": w(d, k), "value": w(d, d),
+            "gate_w": w(2 * d, d), "gate_b": 0.1 * rng.standard_normal(d),
+            "conv_w": w(2 * d, 3), "conv_b": 0.1 * rng.standard_normal(2 * d),
+            "local_w": w(2 * d, d), "local_b": 0.1 * rng.standard_normal(d),
+            "mix": float(rng.normal()),
+            "mha_in_w": w(3 * d, d), "mha_in_b": 0.1 * rng.standard_normal(3 * d),
+            "mha_out_w": w(d, d), "mha_out_b": 0.1 * rng.standard_normal(d),
+            "ln_g": 1 + 0.2 * rng.standard_normal(d), "ln_b": 0.1 * rng.standard_normal(d),
+        }
+    params["lr"] = {"w2": w(2 * d, rank), "b2": 0.1 * rng.standard_normal(rank),
+                    "w3": w(rank, d), "b3": 0.1 * rng.standard_normal(d)}
+    return params
+
+
+def two_streams(seed: int, steps: int = T):
+    rng = np.random.default_rng(seed)
+    return rng.standard_normal((steps, D)), rng.standard_normal((steps, D))
+
+
+# ===================================================================================================== Block 9 (numpy)
+def test_b9_ref_round_one_is_the_plain_c2f_layer():
