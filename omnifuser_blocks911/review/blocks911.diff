+def _probabilities(seed: int, n: int = 60, p: int = 96, decimals: int | None = None, absent: int | None = None):
+    rng = np.random.default_rng(seed)
+    logits = rng.standard_normal((n, p, 3))
+    probs = np.exp(logits) / np.exp(logits).sum(axis=-1, keepdims=True)
+    labels = rng.integers(0, 3, (n, p))
+    if absent is not None:
+        labels = np.where(labels == absent, (absent + 1) % 3, labels)
+    if decimals is not None:
+        probs = np.round(probs, decimals)
+    return probs, labels
+
+
+def _check_scores(report: dict, expected: dict) -> None:
+    for key, value in expected.items():
+        assert np.isclose(report[key], value, rtol=1e-12, atol=1e-14), (key, report[key], value)
+
