+def test_b9_ref_a_constant_forecast_cannot_follow_a_trajectory():
+    """Why prediction_head='paper_literal' cannot reproduce the trajectories of Fig. 10: if the forecast does not
+    depend on the lead, its best MSE is the variance of the target over the leads; one weight block per lead can
+    fit the trajectory (least squares on a handful of synthetic samples)."""
+    rng = np.random.default_rng(11)
+    n, lead_count = 400, 8
+    z = rng.standard_normal((n, D))
+    ramp = np.linspace(-1.0, 1.0, lead_count)[None, :, None]
+    target = z[:, :1, None] * 0.5 + ramp * 2.0 + 0.01 * rng.standard_normal((n, lead_count, 1))
+    design = np.c_[z, np.ones(n)]
+    literal = np.linalg.lstsq(design, target.mean(axis=1), rcond=None)[0]      # one block for all leads
+    literal_mse = np.mean((target - (design @ literal)[:, None, :]) ** 2)
+    per_lead = np.linalg.lstsq(design, target.reshape(n, -1), rcond=None)[0]   # one block per lead
+    direct_mse = np.mean((target.reshape(n, -1) - design @ per_lead) ** 2)
+    assert literal_mse > 1.0 and direct_mse < 0.01, (literal_mse, direct_mse)
