+def test_b11_baselines_per_horizon_match_numpy():
+    from omnifuser.evaluation import baseline_report
+
+    rng = np.random.default_rng(10)
+    n, p = 50, 96
+    target = rng.standard_normal((n, p, 3))
+    last = rng.standard_normal((n, 3))
+    shown = rng.integers(0, 3, n)
+    classes = rng.integers(0, 3, (n, p))
+    report = baseline_report(last, target, shown, classes)
+    assert np.isclose(report["last_value_mse"], np.mean((target - last[:, None, :]) ** 2), rtol=1e-12)
+    assert sorted(report["by_horizon"], key=int) == [str(h) for h in b9.PAPER_HORIZONS]
+    for horizon in b9.PAPER_HORIZONS:
+        row = report["by_horizon"][str(horizon)]
+        assert np.isclose(row["last_value_mse"], np.mean((target[:, :horizon] - last[:, None, :]) ** 2), rtol=1e-12)
+        assert np.isclose(row["last_value_mae"], np.mean(np.abs(target[:, :horizon] - last[:, None, :])), rtol=1e-12)
+        assert np.isclose(row["zero_prediction_mse"], np.mean(target[:, :horizon] ** 2), rtol=1e-12)
+        assert np.isclose(row["persistence_class_accuracy"], np.mean(classes[:, :horizon] == shown[:, None]), rtol=1e-12)
+    assert sorted(baseline_report(last, target[:, :20], shown, classes[:, :20])["by_horizon"], key=int) == ["12"]
+
