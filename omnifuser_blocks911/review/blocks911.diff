+def test_b11_compare_with_paper_aggregates_folds(tmp=None):
+    import importlib.util
+    import json
+
+    spec = importlib.util.spec_from_file_location("compare_with_paper", ROOT / "scripts" / "compare_with_paper.py")
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    rng = np.random.default_rng(11)
+
+    def fold(tool, offset):
+        horizons = {str(h): {"mse": 0.5 + offset + h / 1000, "mae": 0.4 + offset, "accuracy": 0.8, "precision_macro": 0.7,
+                             "recall_macro": 0.7, "f1_macro": 0.7, "precision_weighted": 0.8, "recall_weighted": 0.8,
+                             "f1_weighted": 0.8} for h in b9.PAPER_HORIZONS}
+        base = {str(h): {"last_value_mse": 0.3, "last_value_mae": 0.3, "zero_prediction_mse": 1.0,
+                         "persistence_class_accuracy": 0.79} for h in b9.PAPER_HORIZONS}
+        return {"test_tool": tool, "image_lag": 1, "pool": 1000, "window_counts": {"test": 10 if tool == "T1" else 30},
+                "test": {"paper_horizons": horizons, "baselines": {"by_horizon": base}}}
+
+    table = module.aggregate([fold("T1", 0.0), fold("T2", 0.2)])
+    assert set(table) == {"mean_over_folds", "pooled_by_windows"}
+    assert np.isclose(table["mean_over_folds"]["12"]["mse"], 0.5 + 0.1 + 0.012)
+    assert np.isclose(table["pooled_by_windows"]["12"]["mse"], (10 * 0.512 + 30 * 0.712) / 40)
+    text = module.render(table, "mean_over_folds")
+    assert "0.467" in text and "12" in text and "last-value" in text
+    assert rng is not None and json.dumps(table)
+    assert module.PAPER_OMNIFUSER == b9.PAPER_OMNIFUSER and module.HORIZONS == b9.PAPER_HORIZONS
+
