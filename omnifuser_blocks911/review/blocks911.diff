+def test_b11_regression_report_physical_units_follow_the_scale():
+    from omnifuser.evaluation import regression_report
+
+    rng = np.random.default_rng(9)
+    pred, true = rng.standard_normal((20, 12, 3)), rng.standard_normal((20, 12, 3))
+    mean, scale = np.array([100.0, -10.0, -20.0]), np.array([30.0, 2.0, 5.0])
+    report = regression_report(pred, true, mean, scale)
+    for index, channel in enumerate(("Fx", "Fy", "Fz")):
+        expected = scale[index] ** 2 * np.mean((pred[..., index] - true[..., index]) ** 2)
+        assert np.isclose(report["by_channel"][channel]["mse"], expected, rtol=1e-10)
+    assert np.isclose(report["normalized"]["mse"], np.mean((pred - true) ** 2), rtol=1e-12)
