+def test_b11_cv_summary_and_compare_script_read_the_real_report_outputs():
+    """Fold results assembled from the real evaluation functions go through the CV summary and the comparison script."""
+    need_torch()
+    import importlib.util
+    import json
+
+    from omnifuser.cross_validation import _summarize_folds, _summarize_paper_horizons
+    from omnifuser.evaluation import (baseline_report, classification_report, cumulative_horizon_report,
+                                      regression_report)
+
+    spec = importlib.util.spec_from_file_location("compare_with_paper", ROOT / "scripts" / "compare_with_paper.py")
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    folds = []
+    for index, tool in enumerate(("T1", "T2", "T3")):
+        rng = np.random.default_rng(20 + index)
+        n, p = 30 + 10 * index, 96
+        pred, true = rng.standard_normal((n, p, 3)), rng.standard_normal((n, p, 3))
+        probs, labels = _probabilities(30 + index, n=n, p=p)
+        report, _ = classification_report(probs, labels)
+        folds.append({
+            "test_tool": tool, "image_lag": 1, "pool": 1000, "window_counts": {"test": n},
+            "test": {"classification_accuracy": report["accuracy"], "classification": report,
+                     "regression": regression_report(pred, true, np.zeros(3), np.ones(3)),
+                     "paper_horizons": cumulative_horizon_report(pred, true, probs, labels),
+                     "baselines": baseline_report(rng.standard_normal((n, 3)), true, labels[:, 0], labels)}})
+    summary = _summarize_folds(folds)
+    assert len(summary["metrics"]["classification_f1_weighted"]["per_fold"]) == 3
+    horizons = _summarize_paper_horizons(folds)
+    assert sorted(horizons["models"], key=int) == [str(h) for h in b9.PAPER_HORIZONS]
+    expected = np.mean([f["test"]["paper_horizons"]["24"]["mse"] for f in folds])
+    assert np.isclose(horizons["models"]["24"]["mse"]["mean"], expected)
+    assert "last_value_mse" in horizons["baselines"]["24"]
+    old = json.loads(json.dumps(folds[0]))
+    old["test"]["classification"].pop("f1_weighted")
+    old["test"]["baselines"].pop("by_horizon")
+    assert _summarize_folds([old, folds[1]])["metrics"]["classification_f1_weighted"]["per_fold"][0] is None
+    table = module.aggregate(json.loads(json.dumps(folds)))
+    text = module.render(table, "pooled_by_windows", "weighted")
+    assert text.count("\n") >= 9 and "96" in text and "model MSE below last-value MSE" in text
+    assert np.isclose(table["mean_over_folds"]["12"]["mse"],
+                      np.mean([f["test"]["paper_horizons"]["12"]["mse"] for f in folds]))
+
+
+if __name__ == "__main__":
+    names = [n for n in sorted(globals()) if n.startswith("test_")]
+    failed = skipped = 0
+    for name in names:
+        try:
+            globals()[name]()
+            print(f"PASS  {name}")
+        except unittest.SkipTest as reason:
+            skipped += 1
+            print(f"SKIP  {name}  ({reason})")
+        except Exception:
+            failed += 1
+            print(f"FAIL  {name}")
+            traceback.print_exc()
+    print(f"\n{len(names) - failed - skipped} passed, {skipped} skipped, {failed} failed")
+    sys.exit(1 if failed else 0)
